# The board: an ESP32-S3 with 16 MB of flash and 8 MB of octal PSRAM (N16R8).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y

# TLS needs room on the stacks that run it.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# The door is served over HTTPS.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# The camera talks to its sensor with ESP-IDF's legacy I2C driver: esp-idf-svc links that one, and the new one aborts beside it.
CONFIG_SCCB_HARDWARE_I2C_DRIVER_LEGACY=y

# Two servers, the door's and the live frames', each with its listening and control sockets.
CONFIG_LWIP_MAX_SOCKETS=16

# The camera's frames are encoded on the CPU, from PSRAM: as fast as the board goes.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM_SPEED_80M=y

# TLS's buffers in PSRAM: in internal RAM a viewer and two more connections left it nothing.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Espressif's QEMU has no Wi-Fi: its emulated Ethernet stands in for it.
CONFIG_ETH_USE_OPENETH=y
